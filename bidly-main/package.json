  "scripts": {
    "ssh": "ssh admin@106.249.102.185 -p 2847",
    "db:generate": "npx prisma generate",
    "db:push": "dotenv -e apps/server/.env -- npx prisma db push",
    "db:push:dev": "dotenv -e apps/server/.env.development -- npx prisma db push",
    "db:push:prod": "dotenv -e apps/server/.env.production -- npx prisma db push",
    "db:studio": "dotenv -e apps/server/.env -- npx prisma studio",
    "db:prod:studio": "dotenv -e apps/server/.env.production -- npx prisma studio",
    "db:dev:studio": "dotenv -e apps/server/.env.development -- npx prisma studio",
    "db:reset": "npx dotenv -e apps/server/.env -- npx prisma migrate reset",
    "db:reset:prod": "npx dotenv -e apps/server/.env.production -- npx prisma migrate reset",
    "dev:webhook": "curl -X POST https://portainer.lepisode.team/api/stacks/webhooks/7c661b55-251c-4d1e-a503-72d33411c3eb",
    "deploy:dev:server": "npx nx build server --skip-nx-cache --configuration=development && docker build --platform linux/amd64 --build-arg environment=development -t lepisoderegistry/bidly-server:dev-latest -f docker/Dockerfile.server . && docker push lepisoderegistry/bidly-server:dev-latest && docker rmi --force lepisoderegistry/bidly-server:dev-latest && npm run dev:webhook",
    "deploy:dev:admin": "npx nx build admin --skip-nx-cache --configuration=development && docker build --platform linux/amd64 --build-arg environment=development -t lepisoderegistry/bidly-admin:dev-latest -f docker/Dockerfile.admin . --push && npm run dev:webhook",
    "deploy:dev:client": "npx nx build client --skip-nx-cache --configuration=development && docker build --platform linux/amd64 --build-arg environment=development -t lepisoderegistry/bidly-client:dev-latest -f docker/Dockerfile.client . && docker push lepisoderegistry/bidly-client:dev-latest && docker rmi --force lepisoderegistry/bidly-client:dev-latest && npm run dev:webhook"
  },
