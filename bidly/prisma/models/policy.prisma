/// 약관 정책
model Policy   {
    id          String   @id @default(cuid()) /// 정책 ID
    title       String   /// 정책 종류 (예: 개인정보 처리방침, 이용약관 등)
    content     String?   /// 내용
    createdAt   DateTime @default(now()) /// 생성 일시
    updatedAt   DateTime @updatedAt /// 수정 일시
    deletedAt   DateTime? /// 삭제 일시
    adminId     String?  /// 작성자 ID
    admin       Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade) /// 작성자

    projects    Project[] // 프로젝트 목록
}