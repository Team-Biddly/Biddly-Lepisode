model Faq {
  id          String      @id @default(uuid())
  title       String
  content     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  isPinned    Boolean
  adminId   String
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

